# Writes gen/openba_build_info.h with the git commit the exe was built from and the build
# date. Run at BUILD time (target openba-build-info, CMakeLists.txt), not configure time, so
# the stamp follows every commit without a reconfigure. The file is rewritten only when its
# content changes, so an unchanged commit does not relink the exe.
#   -DOUT=<header path> -DSRC=<source dir>
execute_process(COMMAND git -C "${SRC}" rev-parse --short=9 HEAD
                OUTPUT_VARIABLE GIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no
                OUTPUT_VARIABLE GIT_DIRTY OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT GIT_HASH)
  set(GIT_HASH "nogit")
endif()
if(GIT_DIRTY)
  set(GIT_HASH "${GIT_HASH}+")   # tracked files modified since that commit
endif()
string(TIMESTAMP BUILD_DATE "%Y-%m-%d" UTC)
set(CONTENT "// Generated by cmake/build_info.cmake at build time. Do not edit.
#pragma once
#define OPENBA_GIT_HASH \"${GIT_HASH}\"
#define OPENBA_BUILD_DATE \"${BUILD_DATE}\"
")
set(OLD "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE "${OUT}" "${CONTENT}")
endif()
